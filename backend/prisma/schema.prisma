// =====================================================
// JOB POSTING
// =====================================================

model JobPosting {
  id          String  @id @default(cuid())
  instituteId String? 
  createdById String

  // Basic Info
  companyName  String
  roleTitle    String
  description  String   @db.Text
  requirements String[]

  // Job Details
  jobType  JobType
  workMode WorkMode
  location String

  // Compensation
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String @default("INR")

  // Availability
  vacancies           Int
  applicationDeadline DateTime

  // Settings
  isResumeRequired Boolean           @default(true)
  status           OpportunityStatus @default(DRAFT)

  // Eligibility (JSON)
  eligibilityCriteria Json?

  // Analytics
  viewsCount          Int @default(0)
  applicationsStarted Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime? 
  closedAt    DateTime? 

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  // Relations
  institute    Institute?       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([instituteId])
  @@index([instituteId, status])
  @@index([status])
  @@index([createdById])
  @@index([applicationDeadline])
  @@index([status, applicationDeadline])
  @@index([isDeleted])
  @@index([status, createdAt])
  @@index([instituteId, createdAt])
  @@map("job_postings")
}

model JobApplication {
  id       String  @id @default(cuid())
  jobId    String
  userId   String
  resumeId String?

  coverLetter String?           @db.Text
  status      ApplicationStatus @default(APPLIED)

  appliedAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  adminNotes String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job    JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume?    @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@index([jobId, status])
  @@index([userId, status])
  @@index([status])
  @@map("job_applications")
}

// =====================================================
// INTERNSHIP
// =====================================================

model Internship {
  id          String  @id @default(cuid())
  instituteId String? 
  createdById String

  // Basic Info
  companyName  String
  roleTitle    String
  description  String   @db.Text
  requirements String[]

  // Internship Specific
  internshipType  InternshipType
  durationValue   Int
  durationType    DurationType
  startDate       DateTime?
  isFlexibleDates Boolean        @default(false)

  // Work Details
  workMode WorkMode
  location String

  // Compensation
  stipendMin      Int?
  stipendMax      Int?
  stipendCurrency String  @default("INR")
  isPaid          Boolean @default(true)

  // PPO Details
  hasPPO     Boolean @default(false)
  ppoDetails String? @db.Text

  // Availability
  vacancies           Int
  applicationDeadline DateTime

  // Settings
  isResumeRequired Boolean           @default(true)
  status           OpportunityStatus @default(DRAFT)

  // Eligibility (JSON)
  eligibilityCriteria Json?

  // Analytics
  viewsCount          Int @default(0)
  applicationsStarted Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  closedAt    DateTime?

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  // Relations
  institute    Institute?              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdBy    User                    @relation("InternshipCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  applications InternshipApplication[]

  @@index([instituteId])
  @@index([instituteId, status])
  @@index([status])
  @@index([createdById])
  @@index([applicationDeadline])
  @@index([status, applicationDeadline])
  @@index([internshipType])
  @@index([isDeleted])
  @@index([status, createdAt])
  @@index([instituteId, createdAt])
  @@map("internships")
}

model InternshipApplication {
  id           String  @id @default(cuid())
  internshipId String
  userId       String
  resumeId     String?

  coverLetter   String?           @db.Text
  availableFrom DateTime? 
  status        ApplicationStatus @default(APPLIED)

  appliedAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  adminNotes String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume     Resume?    @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@unique([internshipId, userId])
  @@index([internshipId])
  @@index([userId])
  @@index([internshipId, status])
  @@index([userId, status])
  @@index([status])
  @@map("internship_applications")
}

// =====================================================
// HACKATHON
// =====================================================

model Hackathon {
  id          String  @id @default(cuid())
  instituteId String? 
  createdById String

  // Basic Info
  title       String
  tagline     String?
  description String   @db.Text
  rules       String?  @db.Text
  themes      String[]

  // Event Details
  mode       HackathonMode
  venue      String?
  websiteUrl String?
  bannerUrl  String? 

  // Contact info for queries
  contactEmail String?
  contactPhone String?

  // Participation Config
  participationType ParticipationType
  minTeamSize       Int               @default(1)
  maxTeamSize       Int               @default(4)

  // Timeline
  registrationStartDate DateTime
  registrationEndDate   DateTime
  eventStartDate        DateTime
  eventEndDate          DateTime
  submissionDeadline    DateTime
  resultsDate           DateTime?

  // Capacity
  maxParticipants Int?

  // Prizes (JSON array)
  prizes Json?

  // Settings
  isResumeRequired Boolean         @default(false)
  status           HackathonStatus @default(DRAFT)

  // Eligibility (JSON)
  eligibilityCriteria Json?

  // Analytics
  viewsCount           Int @default(0)
  registrationsStarted Int @default(0)

  // Analytics & Counts
  participantCount Int @default(0) 
  teamCount        Int @default(0) 

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  institute     Institute?              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdBy     User                    @relation("HackathonCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  registrations HackathonRegistration[]
  teams         HackathonTeam[]
  submissions   HackathonSubmission[]

  @@index([instituteId])
  @@index([instituteId, status])
  @@index([status])
  @@index([createdById])
  @@index([registrationStartDate, registrationEndDate])
  @@index([eventStartDate, eventEndDate])
  @@index([status, eventStartDate])
  @@index([isDeleted])
  @@index([status, createdAt])
  @@index([instituteId, createdAt])
  @@map("hackathons")
}

model HackathonRegistration {
  id          String  @id @default(cuid())
  hackathonId String
  userId      String
  teamId      String? 

  status   HackathonRegistrationStatus @default(REGISTERED)
  resumeId String?

  registeredAt DateTime  @default(now())
  confirmedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hackathon  Hackathon            @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       HackathonTeam?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  resume     Resume?              @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  submission HackathonSubmission? 

  @@unique([hackathonId, userId])
  @@index([hackathonId])
  @@index([userId])
  @@index([hackathonId, status])
  @@index([teamId])
  @@map("hackathon_registrations")
}

model HackathonTeam {
  id          String @id @default(cuid())
  hackathonId String
  name        String
  inviteCode  String @unique 
  leaderId    String

  status TeamStatus @default(FORMING)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  currentSize Int      @default(1) 

  hackathon     Hackathon             @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  leader        User                  @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members       HackathonTeamMember[]
  registrations HackathonRegistration[]
  submission    HackathonSubmission?

  @@index([hackathonId])
  @@index([hackathonId, status])
  @@index([inviteCode])
  @@index([leaderId])
  @@map("hackathon_teams")
}

model HackathonTeamMember {
  id     String         @id @default(cuid())
  teamId String
  userId String
  role   TeamMemberRole

  joinedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("hackathon_team_members")
}

model HackathonSubmission {
  id             String  @id @default(cuid())
  hackathonId    String
  teamId         String? 
  registrationId String? 

  // Project Details
  projectName        String
  projectDescription String   @db.Text
  techStack          String[]

  // Links
  repositoryUrl   String
  demoUrl         String?
  videoUrl        String?
  presentationUrl String?

  // Files
  screenshotsUrls String[]

  // Submission Meta
  status      HackathonSubmissionStatus @default(DRAFT)
  submittedAt DateTime?

  // Judging 
  score    Float?
  rank     Int?
  feedback String? @db.Text
  prizeWon String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastSavedAt DateTime @default(now()) 

  hackathon    Hackathon              @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  team         HackathonTeam?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registration HackathonRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([teamId]) 
  @@unique([registrationId]) 
  @@index([hackathonId])
  @@index([hackathonId, status])
  @@index([status])
  @@index([hackathonId, rank])
  @@map("hackathon_submissions")
}