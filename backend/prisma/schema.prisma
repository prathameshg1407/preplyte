// =====================================================
// LMS - CATEGORY
// =====================================================

model LmsCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  iconUrl     String?
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses LmsCourse[]

  @@index([isActive])
  @@index([slug])
  @@map("lms_categories")
}

// =====================================================
// LMS - COURSE
// =====================================================

model LmsCourse {
  id         String @id @default(cuid())
  categoryId String

  // Basic Info
  title            String
  slug             String          @unique
  shortDescription String          @db.VarChar(255) 
  description      String          @db.Text
  thumbnailUrl     String?
  previewVideoUrl  String?

  // Course Stats
  totalModules Int   @default(0)
  totalTopics  Int   @default(0)
  totalPoints  Int   @default(0) 
  totalHours   Float @default(0) 

  // Pricing
  price         Float   @default(0) 
  discountPrice Float?
  currency      String  @default("INR")

  // Status
  status   LmsCourseStatus @default(DRAFT)
  isActive Boolean         @default(true)

  // Settings
  certificateEnabled Boolean @default(true)
  passingPercentage  Float   @default(60) 

  // Metadata
  tags          String[]
  difficulty    DifficultyLevel @default(MEDIUM)
  instructor    String?
  language      String          @default("English")
  averageRating Float @default(0)
  ratingsCount  Int   @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Relations
  category    LmsCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modules     LmsModule[]
  enrollments LmsEnrollment[]
  finalTest   LmsFinalTest?
  feedbacks   LmsCourseFeedback[]
  comments    LmsCourseComment[]

  @@index([categoryId])
  @@index([status, isActive])
  @@index([slug])
  @@index([price])
  @@index([difficulty])
  @@map("lms_courses")
}

// =====================================================
// LMS - MODULE
// =====================================================

model LmsModule {
  id       String @id @default(cuid())
  courseId String

  // Basic Info
  title            String
  shortDescription String  @db.VarChar(500) 
  description      String? @db.Text
  order            Int

  // Module Stats
  totalTopics      Int   @default(0)
  points           Int   @default(0) 
  estimatedMinutes Int   @default(0) 

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  course         LmsCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics         LmsTopic[]
  moduleTest     LmsModuleTest?
  moduleProgress LmsModuleProgress[]

  @@unique([courseId, order])
  @@index([courseId])
  @@index([courseId, isActive])
  @@map("lms_modules")
}

// =====================================================
// LMS - TOPIC
// =====================================================

model LmsTopic {
  id       String @id @default(cuid())
  moduleId String

  // Basic Info
  title       String
  description String? @db.Text
  order       Int

  // Content
  theoryContent String  @db.Text 
  videoUrl      String? 
  videoDuration Int?    

  // Topic Stats
  estimatedMinutes Int @default(10)

  // Resources
  resources Json? 

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  module        LmsModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  topicProgress LmsTopicProgress[]

  @@unique([moduleId, order])
  @@index([moduleId])
  @@index([moduleId, isActive])
  @@map("lms_topics")
}

// =====================================================
// LMS - MODULE TEST
// =====================================================

model LmsModuleTest {
  id       String @id @default(cuid())
  moduleId String @unique

  title        String
  instructions String? @db.Text

  // Test Configuration
  totalQuestions   Int @default(10)
  passingScore     Int @default(60) 
  timeLimitMinutes Int @default(30)
  maxAttempts      Int @default(3) 

  // Points Configuration
  pointsPerQuestion Int @default(10)
  totalPoints       Int @default(100) 

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  module    LmsModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions LmsTestQuestion[]
  attempts  LmsTestAttempt[]

  @@map("lms_module_tests")
}

// =====================================================
// LMS - FINAL TEST
// =====================================================

model LmsFinalTest {
  id       String @id @default(cuid())
  courseId String @unique

  title        String
  instructions String? @db.Text

  // Test Configuration
  totalQuestions   Int @default(50)
  passingScore     Int @default(60) 
  timeLimitMinutes Int @default(120)

  // Points Configuration
  pointsPerQuestion Int @default(10)
  totalPoints       Int @default(500)

  // Final test is allowed only once
  maxAttempts Int @default(1)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  course    LmsCourse          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions LmsTestQuestion[]
  attempts  LmsTestAttempt[]

  @@map("lms_final_tests")
}

// =====================================================
// LMS - TEST QUESTIONS
// =====================================================

model LmsTestQuestion {
  id String @id @default(cuid())

  // Polymorphic reference
  moduleTestId String?
  finalTestId  String?

  questionText String @db.Text
  explanation  String? @db.Text

  order    Int
  points   Int     @default(10)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  moduleTest LmsModuleTest? @relation(fields: [moduleTestId], references: [id], onDelete: Cascade)
  finalTest  LmsFinalTest?  @relation(fields: [finalTestId], references: [id], onDelete: Cascade)
  options    LmsTestOption[]
  responses  LmsTestResponse[]

  @@index([moduleTestId])
  @@index([finalTestId])
  @@index([moduleTestId, order])
  @@index([finalTestId, order])
  @@map("lms_test_questions")
}

// =====================================================
// LMS - TEST OPTIONS
// =====================================================

model LmsTestOption {
  id         String @id @default(cuid())
  questionId String

  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question LmsTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("lms_test_options")
}

// =====================================================
// LMS - ENROLLMENT
// =====================================================

model LmsEnrollment {
  id       String @id @default(cuid())
  userId   String
  courseId String

  status LmsEnrollmentStatus @default(ACTIVE)

  // Progress Tracking
  completedModules Int   @default(0)
  completedTopics  Int   @default(0)
  progressPercent  Float @default(0)

  // Points & Scores
  totalPointsEarned      Int @default(0)
  moduleTestPointsEarned Int @default(0)
  finalTestPointsEarned  Int @default(0)

  // Final Test Result
  finalTestAttempted Boolean @default(false)
  finalTestPassed    Boolean @default(false)
  finalTestScore     Float?
  finalTestMarks     Int?

  // Timestamps
  enrolledAt     DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessedAt DateTime?

  // Certificate
  certificateUrl      String?
  certificateIssuedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course LmsCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@map("lms_enrollments")
}

// =====================================================
// LMS - MODULE PROGRESS
// =====================================================

model LmsModuleProgress {
  id       String @id @default(cuid())
  userId   String
  moduleId String

  status LmsModuleStatus @default(LOCKED)

  // Topic Progress
  completedTopics Int   @default(0)
  totalTopics     Int   @default(0)
  progressPercent Float @default(0)

  // Test Progress
  testAttempted   Boolean @default(false)
  testPassed      Boolean @default(false)
  testScore       Float?
  testAttempts    Int     @default(0)
  pointsEarned    Int     @default(0)

  // Time Tracking
  timeSpentMinutes Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module LmsModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@index([userId, status])
  @@map("lms_module_progress")
}

// =====================================================
// LMS - TOPIC PROGRESS
// =====================================================

model LmsTopicProgress {
  id      String @id @default(cuid())
  userId  String
  topicId String

  status LmsTopicStatus @default(NOT_STARTED)

  // Content Progress
  theoryCompleted Boolean @default(false)
  videoWatched    Boolean @default(false)
  videoProgress   Int     @default(0) 

  // Time Tracking
  timeSpentMinutes Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic LmsTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
  @@index([userId, status])
  @@map("lms_topic_progress")
}

// =====================================================
// LMS - TEST ATTEMPT
// =====================================================

model LmsTestAttempt {
  id     String @id @default(cuid())
  userId String

  // Polymorphic reference
  moduleTestId String?
  finalTestId  String?

  testType LmsTestType
  status   LmsTestAttemptStatus @default(IN_PROGRESS)

  // Attempt Info
  attemptNumber Int @default(1)

  // Scores
  totalQuestions Int   @default(0)
  correctAnswers Int   @default(0)
  wrongAnswers   Int   @default(0)
  unanswered     Int   @default(0)
  score          Float @default(0) 
  pointsEarned   Int   @default(0)
  marksObtained  Int   @default(0)
  totalMarks     Int   @default(0)

  isPassed Boolean @default(false)

  // Timing
  timeLimitMinutes Int @default(0)
  timeSpentSeconds Int @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleTest LmsModuleTest?   @relation(fields: [moduleTestId], references: [id], onDelete: Cascade)
  finalTest  LmsFinalTest?    @relation(fields: [finalTestId], references: [id], onDelete: Cascade)
  responses  LmsTestResponse[]

  @@index([userId])
  @@index([moduleTestId])
  @@index([finalTestId])
  @@index([userId, moduleTestId])
  @@index([userId, finalTestId])
  @@index([status])
  @@map("lms_test_attempts")
}

// =====================================================
// LMS - TEST RESPONSE
// =====================================================

model LmsTestResponse {
  id         String @id @default(cuid())
  attemptId  String
  questionId String

  selectedOptionId String?
  isCorrect        Boolean?
  pointsAwarded    Int      @default(0)

  answeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempt  LmsTestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question LmsTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("lms_test_responses")
}

// =====================================================
