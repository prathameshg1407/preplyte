// prisma/tsconfig.json
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["./**/*"],
  "exclude": ["../node_modules"]
}